@inject ApiPaises.Services.ServicioPaises Paises
@{
    var seccion = (ViewData["Seccion"] as string) ?? "";
    var total = await Paises.ContarAsync();
    string Activo(string s) => seccion == s ? "activo" : "";
}
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Atlas de Países</title>
<meta name="theme-color" content="#10303f">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%2310303f'/%3E%3Ccircle cx='16' cy='16' r='9' fill='none' stroke='%23f1e3c4' stroke-width='2'/%3E%3Cpath d='M7 16h18M16 7c3 3 3 15 0 18M16 7c-3 3-3 15 0 18' fill='none' stroke='%23f1e3c4' stroke-width='1.6'/%3E%3C/svg%3E">
<link rel="stylesheet" href="~/css/atlas.css" asp-append-version="true">
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-buscar" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></symbol>
  <symbol id="i-mundo" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.6 2.4 3.8 5.2 3.8 8.5s-1.2 6.1-3.8 8.5c-2.6-2.4-3.8-5.2-3.8-8.5S9.4 5.9 12 3.5Z"/></symbol>
  <symbol id="i-barras" viewBox="0 0 24 24"><path d="M5 20V11M12 20V4M19 20v-6"/></symbol>
  <symbol id="i-nube" viewBox="0 0 24 24"><path d="M7 18a4 4 0 0 1-.6-7.96A5.5 5.5 0 0 1 17 8.8 4.6 4.6 0 0 1 17.5 18"/><path d="M12 11v7m-2.500-2.500L12 18l2.500-2.500"/></symbol>
  <symbol id="i-api" viewBox="0 0 24 24"><path d="M8 7 3.500 12 8 17M16 7l4.500 5L16 17M13.500 5l-3 14"/></symbol>
  <symbol id="i-mas" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12.500 4.500 4.500L19 7.500"/></symbol>
  <symbol id="i-papelera" viewBox="0 0 24 24"><path d="M4.500 7h15M9.500 7V4.500h5V7M6.500 7l.8 12.500h9.400L17.500 7M10 11v5M14 11v5"/></symbol>
  <symbol id="i-uni" viewBox="0 0 24 24"><path d="M3 9.500 12 5l9 4.500-9 4.500-9-4.500Z"/><path d="M7 12v4.500c0 1 2.200 2 5 2s5-1 5-2V12M21 9.500v5"/></symbol>
</svg>

<div class="app">
  <aside class="panel" aria-label="Navegación">
    <div class="marca">
      <span class="marca-logo" aria-hidden="true"><svg class="ic"><use href="#i-mundo"/></svg></span>
      <div>
        <h1>Atlas de Países</h1>
        <p>Taller de consumo de API con MVC (.NET)</p>
      </div>
    </div>

    <nav class="menu">
      <a asp-controller="Paises" asp-action="Index" class="@Activo("paises")"><svg class="ic"><use href="#i-mundo"/></svg><span>Países</span></a>
      <a asp-controller="Paises" asp-action="Consultar" class="@Activo("api")"><svg class="ic"><use href="#i-api"/></svg><span>Consultar la API</span></a>
      <a asp-controller="Paises" asp-action="Reportes" class="@Activo("reportes")"><svg class="ic"><use href="#i-barras"/></svg><span>Reportes</span></a>
      <a asp-controller="Universidades" asp-action="Index" class="@Activo("universidades")"><svg class="ic"><use href="#i-uni"/></svg><span>Universidades</span></a>
    </nav>

    <div class="panel-pie">
      <p class="estado-base"><b class="num">@total.ToString("N0")</b> <span>@(total == 1 ? "país" : "países") en la base de datos</span></p>
      <form asp-controller="Paises" asp-action="Importar" method="post" data-ocupado>
        <button class="boton boton-crema" type="submit"><svg class="ic"><use href="#i-nube"/></svg><span>Importar países</span></button>
      </form>
      <p class="nota">Descarga los países de la API pública y los guarda en la base sin duplicarlos.</p>
    </div>
  </aside>

  <main class="contenido">
    @RenderBody()
  </main>
</div>

<div class="avisos" role="status" aria-live="polite">
  @if (TempData["Aviso"] is string aviso) { <div class="aviso"><svg class="ic"><use href="#i-check"/></svg><span>@aviso</span></div> }
  @if (TempData["Error"] is string fallo) { <div class="aviso error-aviso"><span>@fallo</span></div> }
</div>
<script src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
