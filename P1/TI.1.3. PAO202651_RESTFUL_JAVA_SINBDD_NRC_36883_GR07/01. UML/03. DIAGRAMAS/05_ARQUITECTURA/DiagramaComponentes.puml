@startuml
skinparam componentStyle rectangle
package "Clientes" {
  [Consola Java]
  [Escritorio Swing]
  [Web Servlets]
  [Android]
}
package "Servidor REST Java / Jakarta EE" {
  [Recursos JAX-RS]
  [Manejadores]
  [Autenticación y tokens]
  [Catálogo y conversores]
  database "Memoria del proceso\n(sin BDD)" as Memoria
}
[Consola Java] --> [Recursos JAX-RS] : HTTPS/HTTP + JSON
[Escritorio Swing] --> [Recursos JAX-RS] : HTTPS/HTTP + JSON
[Web Servlets] --> [Recursos JAX-RS] : HTTP + JSON
[Android] --> [Recursos JAX-RS] : HTTP + JSON
[Recursos JAX-RS] --> [Manejadores]
[Manejadores] --> [Autenticación y tokens]
[Manejadores] --> [Catálogo y conversores]
[Autenticación y tokens] --> Memoria
[Catálogo y conversores] --> Memoria
@enduml
