<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:contentDescription="@string/titulo"
            android:scaleType="centerCrop"
            android:src="@drawable/monster" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="-34dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_tarjeta"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/titulo"
                android:textColor="@color/azul"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Longitud · Masa · Temperatura"
                android:textColor="#5B6B86"
                android:textSize="13sp" />

            <TextView
                style="@style/Etiqueta"
                android:text="@string/usuario" />

            <EditText
                android:id="@+id/txtUsuario"
                style="@style/Campo"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                style="@style/Etiqueta"
                android:text="@string/clave" />

            <EditText
                android:id="@+id/txtClave"
                style="@style/Campo"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/lblServidor"
                style="@style/Etiqueta"
                android:clickable="true"
                android:focusable="true"
                android:drawableLeft="@drawable/ic_flecha_der"
                android:drawablePadding="8dp"
                android:contentDescription="Servidor" />

            <EditText
                android:id="@+id/txtServidor"
                style="@style/Campo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnIngresar"
                style="@style/Boton"
                android:layout_marginTop="18dp"
                android:text="@string/iniciar_sesion" />

            <TextView
                android:id="@+id/lblEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:minHeight="24dp"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
